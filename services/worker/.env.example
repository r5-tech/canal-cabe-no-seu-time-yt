# Telegram: crie o bot no @BotFather e pegue seu chat id com /id no bot depois de subir o worker
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube: client OAuth "App para computador" no Google Cloud + refresh token (npm run youtube-auth)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Os 10 horários de segunda-feira (Brasília). O #10 sai no primeiro, o #1 no último.
HORARIOS_PUBLICACAO=08:00,09:30,11:00,12:30,14:00,15:30,17:00,18:30,20:00,21:30
# Janela de render (hora início-fim, 24h). "sempre" para ignorar
JANELA_RENDER=01-07
# Quantos shorts podem ficar esperando sua aprovação antes de pausar o render
MAX_EM_REVISAO=12
# 1 = cria uma playlist pública por semana e coloca os 10 shorts nela
PLAYLIST_SEMANAL=1

# Instagram (Reels): 1 = publica cada short aprovado também no Instagram, no mesmo horário do YouTube
INSTAGRAM=0
# ID da conta profissional e token de longa duração (60 dias; o worker renova sozinho toda semana)
IG_USER_ID=
IG_TOKEN=
# graph.instagram.com (login do Instagram, padrão) ou graph.facebook.com (login do Facebook + Página)
IG_HOST=graph.instagram.com

CANAL_NOME=Cabe No Seu Time
# 1 = não chama Telegram nem YouTube (teste local)
DRY_RUN=0
